<Configuration>
    <VGpu>Disable</VGpu>
    <Networking>Disable</Networking>
    <MemoryInMB>2048</MemoryInMB>

    <MappedFolders>
        <MappedFolder>
            <HostFolder>C:\ThreatBox\runtime\sample</HostFolder>
            <SandboxFolder>C:\ThreatBox\sample</SandboxFolder>
            <ReadOnly>true</ReadOnly>
        </MappedFolder>

        <MappedFolder>
            <HostFolder>C:\ThreatBox\runtime\output</HostFolder>
            <SandboxFolder>C:\ThreatBox\output</SandboxFolder>
            <ReadOnly>false</ReadOnly>
        </MappedFolder>

        <MappedFolder>
            <HostFolder>C:\ThreatBoxSandbox</HostFolder>
            <SandboxFolder>C:\ThreatBox\tools</SandboxFolder>
            <ReadOnly>true</ReadOnly>
        </MappedFolder>
    </MappedFolders>

    <LogonCommand>
        <Command>cmd.exe /c start "" C:\ThreatBox\tools\etw-collector.exe &amp; call C:\ThreatBox\tools\wait-ready.bat &amp; C:\ThreatBox\sample\sample.exe &amp; taskkill /IM etw-collector.exe /F /T &gt;nul 2&gt;&amp;1 &amp; echo done&gt;C:\ThreatBox\output\analysis.done &amp; shutdown /s /t 0 /f</Command>
    </LogonCommand>
</Configuration>
